# ---------------------------------------------------------------------------
# agent-core environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Shared secret for service-to-service authentication.
# Must match AGENT_CORE_SERVICE_KEY in the main backend's .env.
AGENT_CORE_SERVICE_KEY=change-me-to-a-long-random-string

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Vector store (ChromaDB) — local persistence path
CHROMA_DB_PATH=./chroma_db

# Structured store (SQLite) — precise, single-valued canonical facts (name,
# location, occupation). Complements ChromaDB: vectors for fuzzy recall, this
# table for exact lookups. Kept separate from Django's db.sqlite3.
CANONICAL_DB_PATH=./canonical_facts.sqlite3

# Main Backend (platform-api) — read-only API consumed for agent config.
# agent-core calls GET {MAIN_BACKEND_BASE_URL}/api/agents/{agent_id}/
MAIN_BACKEND_BASE_URL=http://localhost:8000
MAIN_BACKEND_SERVICE_KEY=
MAIN_BACKEND_TIMEOUT=10

# LLM providers — orchestrated by llm/llm_router.py (provider-agnostic).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embeddings — memory vector representations (memory/embeddings.py).
#   EMBEDDING_PROVIDER: openai | placeholder
#     openai      -> real semantic embeddings (needs OPENAI_API_KEY)
#     placeholder -> deterministic hash, offline/dev only (not semantic)
#   NOTE: changing the provider/model/dimensions changes the vector size, which
#   is incompatible with an existing ChromaDB store — delete CHROMA_DB_PATH to
#   re-index after changing any of these.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=            # optional: reduce OpenAI embedding size

# Observability — expose the per-turn decision trace + metrics on /chat/ when the
# request sets "debug": true. Set to False in production to disable trace exposure
# entirely regardless of the request flag.
AGENT_CORE_EXPOSE_TRACE=True
