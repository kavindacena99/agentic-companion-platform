# ---------------------------------------------------------------------------
# agent-core environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Vector store (ChromaDB) — local persistence path
CHROMA_DB_PATH=./chroma_db

# Main Backend (platform-api) — read-only API consumed for agent config.
# agent-core calls GET {MAIN_BACKEND_BASE_URL}/api/agents/{agent_id}/
MAIN_BACKEND_BASE_URL=http://localhost:8000
MAIN_BACKEND_SERVICE_KEY=
MAIN_BACKEND_TIMEOUT=10

# LLM providers — orchestrated by llm/llm_router.py (provider-agnostic).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
